source "https://rubygems.org"

# Matches the exact Jekyll/plugin versions GitHub Pages runs server-side,
# so a local `bundle exec jekyll serve` builds the same output Pages will.
gem "github-pages", group: :jekyll_plugins

# Ruby 3.x no longer bundles these as default gems.
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
